#!/usr/bin/env python3
from pathlib import Path
import sys

R=Path(__file__).resolve().parents[1]
BG=(R/"src/game/bg.c").read_text(errors="replace")
LM=(R/"src/game/levelmodifiers.c").read_text(errors="replace")
BV=(R/"src/game/bondview2.c").read_text(errors="replace")
MK=(R/"Makefile").read_text(errors="replace")

C=[]
def ck(n,x):
    C.append((n,bool(x)))
    print(("[PASS] " if x else "[FAIL] ")+n)

start=BG.find("void bgDetermineVisibleRooms(void)")
end=BG.find("/**\n * Address 0x7F0B8D78.",start)
vis=BG[start:end] if start>=0 and end>=0 else ""
mark=vis.find("R27S R5: PD-style synthetic-hole visibility seeds")
nbr=vis.find("temp_v1 = g_BgPortals[var_s0].connectedRoom1;")
q=max(vis.rfind("while (bgProcessNextQueuedPortal"),vis.rfind("bgProcessNextQueuedPortal()"))

# R27S R5 R1: end the audited block at its own #endif. The normal GE
# neighbour-loop header immediately after it reads g_BgPortals and is not
# part of the R5 injection.
bend=vis.find("#endif",mark)
if bend>=0:
    bend+=len("#endif")
blk=vis[mark:bend] if mark>=0 and bend>mark else ""

ck("Temple/Complex synthetic-hole policy remains modifier scoped",
   "levelModifiersUseCurrentStanRoomForHoleTraversal" in LM
   and "g_LevelModifierTempleFallActive" in LM
   and "g_LevelModifierComplexFallActive" in LM)

ck("R4 R1 collision-room ownership fallback remains",
   "R27S R4 R1: synthetic hole links" in BV
   and "current_tile_ptr->room" in BV
   and "current_tile_ptr_for_portals->room" in BV)

ck("bg.c imports levelmodifiers policy",
   '#include "levelmodifiers.h"' in BG)

ck("secondary visibility seed executes after retail portal traversal",
   mark>=0 and q>=0 and mark>q)

ck("secondary visibility seed executes before neighbour marking",
   mark>=0 and nbr>mark)

ck("retail GE current-room seed remains authoritative",
   "sub_GAME_7F0B39BC(g_BgCurrentRoom, 0, &g_CurrentPlayer->screensize, 1);" in vis
   and vis.find("sub_GAME_7F0B39BC(g_BgCurrentRoom, 0, &g_CurrentPlayer->screensize, 1);") < mark)

ck("synthetic visibility adds only the opposite portal-owned endpoint",
   "current_tile_ptr_for_portals->room" in blk
   and "current_tile_ptr->room" not in blk)

ck("synthetic visibility reuses one existing GE visible-room merge",
   blk.count("sub_GAME_7F0B39BC(")==1)

ck("synthetic visibility uses the live viewport",
   blk.count("&g_CurrentPlayer->screensize")==1)

ck("synthetic visibility does not mutate BG portal topology",
   "g_BgPortals[" not in blk)

ck("synthetic visibility does not rewrite STAN",
   "stanRebuildRoomData" not in blk
   and "stanSet" not in blk)

ck("normal GoldenEye portal traversal remains present",
   "bgQueuePortalTraversal" in vis
   and "bgProcessNextQueuedPortal" in vis)

ck("R5 R2 avoids redundant collision-room insertion",
   "R27S R5 R2:" in BG
   and blk.count("sub_GAME_7F0B39BC(")==1
   and "current_tile_ptr->room" not in blk)

pr=next((x for x in MK.splitlines() if x.startswith("prerequisites:")),"")
ck("R27S R4 R1 focused audit remains mandatory",
   "r27s-r4-r1-mcm-hole-room-tp-solo-mp-audit" in pr)

ck("R27S R5 audit is mandatory",
   "r27s-r5-synthetic-hole-visibility-audit" in pr
   and "r27s-r5-synthetic-hole-visibility-audit:" in MK)

bad=[n for n,v in C if not v]
print()
print("R27S R5 SYNTHETIC-HOLE VISIBILITY AUDIT: "
      + ("PASS" if not bad else "FAIL")
      + f" ({len(C)-len(bad)}/{len(C)})")
if bad:
    for n in bad:
        print(" - "+n)
    sys.exit(1)
