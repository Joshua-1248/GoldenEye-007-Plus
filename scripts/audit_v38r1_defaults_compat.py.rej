+check('TP Crouched Cam Height authored default is 46 in both headers', '#define TP_CROUCH_CAM_HEIGHT_DEFAULT 46' in OPTH and '#define TP_CROUCH_CAM_HEIGHT_DEFAULT 46' in ROOTOPTH)
