/*
 * R27Z/R28 player-like Simulant motor.
 *
 * Perfect Dark's bots do not inherit their locomotion from guard ACT_GOPOS
 * root motion.  They maintain forward/side inputs and inject lateral motion
 * into the chr position update.  These values are intentionally conservative
 * for GoldenEye; personalities such as SpeedBot/IronBot are applied as a
 * separate multiplier so their established 2x / 0.5x rules remain intact.
 */
static f32 g_ModMpBotMoveSpeed[MODBOT_DIFFICULTY_MAX] = {
    4.75f, 5.25f, 5.75f, 6.35f, 7.0f, 7.35f
};

static f32 g_ModMpBotTurnRate[MODBOT_DIFFICULTY_MAX] = {
    0.030f, 0.040f, 0.055f, 0.070f, 0.090f, 0.115f
};

