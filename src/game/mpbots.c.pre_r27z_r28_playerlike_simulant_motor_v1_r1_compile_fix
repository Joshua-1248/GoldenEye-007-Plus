const char *modMpBotGetDisplayName(s32 slot)
{
    struct ModMpBotConfig *config;

    if ((u32)slot >= MOD_MP_BOT_MAX)
        return "Bot";

    config = &g_ModMpBotConfigs[slot];

    if (config->type == MODBOT_TYPE_NONE)
    {
        s32 difficulty = config->difficulty;
        if ((u32)difficulty >= MODBOT_DIFFICULTY_MAX)
            difficulty = MODBOT_DIFFICULTY_NORMAL;
        return g_ModMpBotNeutralNames[difficulty];
    }

    return modMpBotGetTypeName(config->type);
}

void modMpBotCycleCharacter(s32 slot, s32 direction)
{
    s32 count;
    s32 value;

    if ((u32)slot >= MOD_MP_BOT_MAX)
        return;

    count = frontGetMpCharacterCount();
    if (count <= 0)
        return;

    if (direction == 0)
        direction = 1;

    value = (s32)g_ModMpBotConfigs[slot].character + direction;
    while (value < 0)
        value += count;
    while (value >= count)
        value -= count;

    g_ModMpBotConfigs[slot].character = (u8)value;
}

void modMpBotCycleDifficulty(s32 slot, s32 direction)
{
    s32 value;

    if ((u32)slot >= MOD_MP_BOT_MAX)
        return;

    if (direction == 0)
        direction = 1;

    value = (s32)g_ModMpBotConfigs[slot].difficulty + direction;
    while (value < 0)
        value += MODBOT_DIFFICULTY_MAX;
    while (value >= MODBOT_DIFFICULTY_MAX)
        value -= MODBOT_DIFFICULTY_MAX;

    g_ModMpBotConfigs[slot].difficulty = (u8)value;
}

void modMpBotCycleType(s32 slot, s32 direction)
{
    s32 value;

    if ((u32)slot >= MOD_MP_BOT_MAX)
        return;

    if (direction == 0)
        direction = 1;

    value = (s32)g_ModMpBotConfigs[slot].type + direction;
    while (value < 0)
        value += MODBOT_TYPE_MAX;
    while (value >= MODBOT_TYPE_MAX)
        value -= MODBOT_TYPE_MAX;

    g_ModMpBotConfigs[slot].type = (u8)value;
}

void modMpBotsResetRuntime(void)
{
    s32 i;

    for (i = 0; i < MOD_MP_BOT_MAX; i++)
    {
        g_ModMpBotRuntime[i].chr = NULL;
        g_ModMpBotRuntime[i].targetprop = NULL;
        g_ModMpBotRuntime[i].lastattacker = MODBOT_ATTACKER_NONE;
        g_ModMpBotRuntime[i].vindicttarget = MODBOT_TARGET_NONE;
        g_ModMpBotRuntime[i].stalktarget = MODBOT_TARGET_NONE;
        g_ModMpBotRuntime[i].decisiontimer = 0;
        g_ModMpBotRuntime[i].meleecooldown = 0;
        g_ModMpBotRuntime[i].respawntimer = 0;
        g_ModMpBotRuntime[i].strafetimer = 0;
        g_ModMpBotRuntime[i].recoverytimer = 0;
        g_ModMpBotRuntime[i].strafedir = (i & 1) ? 1 : -1;
        g_ModMpBotRuntime[i].deathrecorded = FALSE;
        g_ModMpBotRuntime[i].moveforward = 0.0f;
        g_ModMpBotRuntime[i].movesideways = 0.0f;
        g_ModMpBotRuntime[i].moveratex = 0.0f;
        g_ModMpBotRuntime[i].moveratez = 0.0f;
        g_ModMpBotRuntime[i].kills = 0;
        g_ModMpBotRuntime[i].deaths = 0;
    }

    for (i = 0; i < MAX_PLAYER_COUNT; i++)
        g_ModMpBotHumanKills[i] = 0;

    g_ModMpBotDamageOwner = -1;
}

s32 modMpBotsGetSlotForChr(ChrRecord *chr)
{
    s32 i;

    if (chr == NULL)
        return -1;

    for (i = 0; i < MOD_MP_BOT_MAX; i++)
    {
        if (g_ModMpBotRuntime[i].chr == chr)
            return i;
    }

    return -1;
}

PropRecord *modMpBotsGetTargetProp(ChrRecord *chr)
{
    s32 slot = modMpBotsGetSlotForChr(chr);

    if (slot < 0)
        return NULL;

    return g_ModMpBotRuntime[slot].targetprop;
}

f32 modMpBotsGetMoveMultiplier(ChrRecord *chr)
{
    s32 slot = modMpBotsGetSlotForChr(chr);

    if (slot >= 0)
    {
        if (g_ModMpBotConfigs[slot].type == MODBOT_TYPE_SPEED)
            return 2.0f;
        if (g_ModMpBotConfigs[slot].type == MODBOT_TYPE_IRON)
            return 0.5f;
    }

    return 1.0f;
}


/*
 * Feed player-like forward/side input into GoldenEye's normal chr collision
 * update.  This is the GoldenEye analogue of Perfect Dark's bot_update_lateral.
 *
 * IMPORTANT: this function only proposes X/Z.  sub_GAME_7F01FC10 still owns
 * STAN validation, wall collision, floor support, gravity and room updates.
 * Bots therefore do not teleport or bypass native collision.
 */
s32 modMpBotsApplyLateral(ChrRecord *chr, coord3d *src, coord3d *dst)
{
    struct ModMpBotRuntime *runtime;
    struct ModMpBotConfig *config;
    s32 slot;
    s32 difficulty;
    f32 forward;
    f32 sideways;
    f32 magnitude;
    f32 scale;
    f32 speed;
    f32 yaw;
    f32 sine;
    f32 cosine;
    f32 desiredx;
    f32 desiredz;
    f32 blend;
    f32 dt;

    if (chr == NULL || src == NULL || dst == NULL || chr->model == NULL)
        return FALSE;

    slot = modMpBotsGetSlotForChr(chr);
    if (slot < 0)
        return FALSE;

    runtime = &g_ModMpBotRuntime[slot];
    config = &g_ModMpBotConfigs[slot];

    if (chrIsDead(chr))
    {
        runtime->moveratex = 0.0f;
        runtime->moveratez = 0.0f;
        return FALSE;
    }

    difficulty = config->difficulty;
    if ((u32)difficulty >= MODBOT_DIFFICULTY_MAX)
        difficulty = MODBOT_DIFFICULTY_NORMAL;

    forward = runtime->moveforward;
    sideways = runtime->movesideways;

    /* Do not allow a diagonal to travel sqrt(2) faster than a cardinal input. */
    magnitude = sqrtf(forward * forward + sideways * sideways);
    if (magnitude > 1.0f)
    {
        scale = 1.0f / magnitude;
        forward *= scale;
        sideways *= scale;
    }

    speed = g_ModMpBotMoveSpeed[difficulty] * modMpBotsGetMoveMultiplier(chr);
    yaw = getsubroty(chr->model);
    sine = sinf(yaw);
    cosine = cosf(yaw);

    /* Same forward/right basis used by PD's bot lateral motor. */
    desiredx = (sideways * cosine + forward * sine) * speed;
    desiredz = (-sideways * sine + forward * cosine) * speed;

    dt = g_GlobalTimerDelta;
    if (dt < 0.0f)
        dt = 0.0f;

    /*
     * Player input does not instantly snap world velocity.  Smooth the desired
     * vector so direction changes look like controller movement rather than
     * an NPC root-animation switch.
     */
    blend = 0.28f * dt;
    if (blend > 1.0f)
        blend = 1.0f;

    runtime->moveratex += (desiredx - runtime->moveratex) * blend;
    runtime->moveratez += (desiredz - runtime->moveratez) * blend;

    /*
     * Override animation root X/Z exactly where PD overrides bot chr root X/Z.
     * GoldenEye's caller immediately collision-tests this destination.
     */
    dst->x = src->x + runtime->moveratex * dt;
    dst->z = src->z + runtime->moveratez * dt;

    return TRUE;
}

