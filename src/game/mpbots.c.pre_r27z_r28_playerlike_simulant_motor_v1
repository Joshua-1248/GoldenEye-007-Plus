void modMpBotsDamageViewer(s32 slot, PropRecord *viewer, ITEM_IDS weaponid, coord3d *direction)
{
    s32 oldplayer;
    s32 victim;
    f32 damage;

    if ((u32)slot >= MOD_MP_BOT_MAX || viewer == NULL || viewer->type != PROP_TYPE_VIEWER)
        return;

    victim = getPlayerPointerIndex(viewer);
    if ((u32)victim >= (u32)getPlayerCount())
        return;

    damage = 0.125f * gunItemGetDestructionAmount(weaponid) * g_AiDamageModifier * get_007_damage_mod();
    if (weaponid == ITEM_SHOTGUN || weaponid == ITEM_AUTOSHOT)
        damage *= 3.0f;

    oldplayer = get_cur_playernum();
    set_cur_player(victim);
    modMpBotsSetDamageOwner(slot);
    record_damage_kills(damage, direction->x, direction->z, victim, 1);
    modMpBotsClearDamageOwner();
    set_cur_player(oldplayer);
}

static PropRecord *modMpBotsResolveTargetCode(s16 code)
{
    s32 index;

    if (code >= MOD_MP_BOT_BOT_TARGET_BASE)
    {
        index = code - MOD_MP_BOT_BOT_TARGET_BASE;
        if ((u32)index < MOD_MP_BOT_MAX
            && g_ModMpBotRuntime[index].chr != NULL
            && g_ModMpBotRuntime[index].chr->prop != NULL
            && !chrIsDead(g_ModMpBotRuntime[index].chr))
            return g_ModMpBotRuntime[index].chr->prop;
        return NULL;
    }

    if ((u32)code < (u32)getPlayerCount()
        && g_playerPointers[code] != NULL
        && g_playerPointers[code]->prop != NULL
        && !g_playerPointers[code]->bonddead)
        return g_playerPointers[code]->prop;

    return NULL;
}

static f32 modMpBotsTargetHealth(PropRecord *prop)
{
    s32 playernum;
    ChrRecord *chr;

    if (prop == NULL)
        return 999999.0f;

    if (prop->type == PROP_TYPE_VIEWER)
    {
        playernum = getPlayerPointerIndex(prop);
        if ((u32)playernum < (u32)getPlayerCount())
            return g_playerPointers[playernum]->bondhealth + g_playerPointers[playernum]->bondarmour;
        return 999999.0f;
    }

    if (prop->type == PROP_TYPE_CHR && prop->chr != NULL)
    {
        chr = prop->chr;
        if (chr->maxdamage > 0.0f)
            return (chr->maxdamage - chr->damage) / chr->maxdamage;
        return 999999.0f;
    }

    return 999999.0f;
}

static s32 modMpBotsHumanScore(s32 playernum)
{
    s32 i;
    s32 points = modMpBotsGetHumanKills(playernum);

    if ((u32)playernum >= (u32)getPlayerCount())
        return -9999;

    for (i = 0; i < getPlayerCount(); i++)
    {
        if (i != playernum)
            points += g_playerPlayerData[playernum].kill_counts[i];
        else
            points -= g_playerPlayerData[i].kill_counts[playernum];
    }

    return points;
}

static PropRecord *modMpBotsChooseTarget(s32 slot)
{
    struct ModMpBotRuntime *runtime = &g_ModMpBotRuntime[slot];
    struct ModMpBotConfig *config = &g_ModMpBotConfigs[slot];
    PropRecord *best = NULL;
    PropRecord *candidate;
    f32 bestmetric = 0.0f;
    f32 metric;
    f32 dx;
    f32 dy;
    f32 dz;
    s32 bestscore = -99999;
    s32 score;
    s32 i;

    if (config->type == MODBOT_TYPE_VINDICT)
    {
        candidate = modMpBotsResolveTargetCode(runtime->vindicttarget);
        if (candidate != NULL)
            return candidate;
    }
    else if (config->type == MODBOT_TYPE_PACIFIST)
    {
        /* GoldenEye has no disarming/alternate unarmed function.  PacifistBot
         * therefore stays passive until somebody damages it, then retaliates
         * against that attacker for the remainder of the current life. */
        candidate = modMpBotsResolveTargetCode(runtime->lastattacker);
        if (candidate != NULL)
            return candidate;
        return NULL;
    }

    if (config->type == MODBOT_TYPE_STALKER)
    {
        candidate = modMpBotsResolveTargetCode(runtime->stalktarget);
        if (candidate != NULL)
            return candidate;
    }

    for (i = 0; i < getPlayerCount(); i++)
    {
        if (g_playerPointers[i] == NULL || g_playerPointers[i]->prop == NULL || g_playerPointers[i]->bonddead)
            continue;

        candidate = g_playerPointers[i]->prop;
        dx = candidate->pos.x - runtime->chr->prop->pos.x;
        dy = candidate->pos.y - runtime->chr->prop->pos.y;
        dz = candidate->pos.z - runtime->chr->prop->pos.z;
        metric = dx * dx + dy * dy + dz * dz;

        if (config->type == MODBOT_TYPE_QUARRY)
            metric = modMpBotsTargetHealth(candidate);
        else if (config->type == MODBOT_TYPE_UMPIRE)
        {
            score = modMpBotsHumanScore(i);
            if (best == NULL || score > bestscore)
            {
                bestscore = score;
                best = candidate;
            }
            continue;
        }
        else if (config->type == MODBOT_TYPE_FEAR)
            metric = -metric;

        if (best == NULL || metric < bestmetric)
        {
            bestmetric = metric;
            best = candidate;
        }
    }

    for (i = 0; i < g_ModMpBotCount; i++)
    {
        if (i == slot || g_ModMpBotRuntime[i].chr == NULL
            || g_ModMpBotRuntime[i].chr->prop == NULL
            || chrIsDead(g_ModMpBotRuntime[i].chr))
            continue;

        candidate = g_ModMpBotRuntime[i].chr->prop;
        dx = candidate->pos.x - runtime->chr->prop->pos.x;
        dy = candidate->pos.y - runtime->chr->prop->pos.y;
        dz = candidate->pos.z - runtime->chr->prop->pos.z;
        metric = dx * dx + dy * dy + dz * dz;

        if (config->type == MODBOT_TYPE_QUARRY)
            metric = modMpBotsTargetHealth(candidate);
        else if (config->type == MODBOT_TYPE_UMPIRE)
        {
            score = g_ModMpBotRuntime[i].kills;
            if (best == NULL || score > bestscore)
            {
                bestscore = score;
                best = candidate;
            }
            continue;
        }
        else if (config->type == MODBOT_TYPE_FEAR)
            metric = -metric;

        if (best == NULL || metric < bestmetric)
        {
            bestmetric = metric;
            best = candidate;
        }
    }

    if (config->type == MODBOT_TYPE_STALKER && best != NULL)
    {
        if (best->type == PROP_TYPE_VIEWER)
            runtime->stalktarget = (s16)getPlayerPointerIndex(best);
        else if (best->type == PROP_TYPE_CHR)
            runtime->stalktarget = modMpBotsTargetCodeFromChr(best->chr);
    }

    return best;
}

static s32 modMpBotsWeaponIsExplosive(s32 item)
{
    return item == ITEM_ROCKETLAUNCH
        || item == ITEM_GRENADELAUNCH
        || item == ITEM_GRENADE
        || item == ITEM_TIMEDMINE
        || item == ITEM_PROXIMITYMINE
        || item == ITEM_REMOTEMINE;
}

static s32 modMpBotsChooseWeaponIndex(s32 slot)
{
    struct s_mp_weapon_set *set = getPtrMPWeaponSetData();
    s32 i;
    s32 best = -1;

    if (g_ModMpBotConfigs[slot].type == MODBOT_TYPE_MELEE)
        return -1;

    if (g_ModMpBotConfigs[slot].type == MODBOT_TYPE_TNT)
    {
        for (i = 7; i >= 0; i--)
        {
            if (set[i].allowpickup && modMpBotsWeaponIsExplosive(set[i].itemID)
                && (set[i].itemID == ITEM_ROCKETLAUNCH || set[i].itemID == ITEM_GRENADELAUNCH))
                return i;
        }
    }

    for (i = 7; i >= 0; i--)
    {
        if (set[i].allowpickup && set[i].itemID != ITEM_UNARMED
            && !modMpBotsWeaponIsExplosive(set[i].itemID))
        {
            best = i;
            break;
        }
    }

    if (best < 0)
    {
        for (i = 7; i >= 0; i--)
        {
            if (set[i].allowpickup && set[i].itemID != ITEM_UNARMED)
                return i;
        }
    }

    return best;
}

static s32 modMpBotsSpawn(s32 slot)
{
    struct ModMpBotRuntime *runtime = &g_ModMpBotRuntime[slot];
    struct ModMpBotConfig *config = &g_ModMpBotConfigs[slot];
    struct s_mp_weapon_set *set;
    PadRecord *pad;
    PropRecord *prop;
    ChrRecord *chr;
    s32 body;
    s32 head;
    s32 weaponindex;
    f32 angle;

    if (startpadcount <= 0 || !frontGetMpCharacterData(config->character, &body, &head, NULL))
        return FALSE;

    pad = g_Startpad[(slot + (randomGetNext() % (u32)startpadcount)) % startpadcount];
    if (pad == NULL || pad->stan == NULL)
        return FALSE;

    angle = atan2f(pad->look.x, pad->look.z);
    prop = chrSpawnAtCoord(body, head, &pad->pos, pad->stan, angle, NULL, 0);
    if (prop == NULL || prop->chr == NULL)
        return FALSE;

    chr = prop->chr;
    chr->accuracyrating = g_ModMpBotAccuracy[config->difficulty];
    chr->speedrating = g_ModMpBotReaction[config->difficulty];
    chrSetMaxDamage(chr, 4.0f);
    chr->damage = 0.0f;
    chr->chrflags |= CHRFLAG_CAN_SHOOT_CHRS;

    /* PD ShieldSim/TurtleSim durability maps to GoldenEye's native character
     * armor representation: negative chr->damage, exposed by chrGetArmor(). */
    if (config->type == MODBOT_TYPE_ARMOR)
        chrAddHealth(chr, 4.0f);
    else if (config->type == MODBOT_TYPE_IRON)
        chrAddHealth(chr, 8.0f);

    runtime->chr = chr;
    runtime->targetprop = NULL;
    runtime->lastattacker = MODBOT_ATTACKER_NONE;
    runtime->decisiontimer = 0;
    runtime->meleecooldown = 0;
    runtime->respawntimer = 0;
    runtime->deathrecorded = FALSE;

    check_set_actor_standing_still(chr, TARGET_BOND, 0);

    weaponindex = modMpBotsChooseWeaponIndex(slot);
    if (weaponindex >= 0)
    {
        set = getPtrMPWeaponSetData();
        chrGiveWeapon(chr, set[weaponindex].propID, (ITEM_IDS)set[weaponindex].itemID, 0);
    }

    return TRUE;
}

static void modMpBotsRemoveActor(s32 slot)
{
    ChrRecord *chr = g_ModMpBotRuntime[slot].chr;
    PropRecord *prop;

    if (chr == NULL)
        return;

    prop = chr->prop;
    if (prop != NULL && chr->model != NULL)
    {
        chrpropCleanupForRemoval(prop);
        chrpropDelist(prop);
        chrpropDisable(prop);
        chrpropFree(prop);
    }

    g_ModMpBotRuntime[slot].chr = NULL;
    g_ModMpBotRuntime[slot].targetprop = NULL;
}

static void modMpBotsRecordDeath(s32 slot)
{
    struct ModMpBotRuntime *runtime = &g_ModMpBotRuntime[slot];
    s32 attacker = runtime->lastattacker;

    runtime->deaths++;

    if (g_ModMpBotConfigs[slot].type == MODBOT_TYPE_VINDICT
        && attacker != MODBOT_ATTACKER_NONE)
    {
        runtime->vindicttarget = (s16)attacker;
    }

    if ((u32)attacker < MAX_PLAYER_COUNT)
    {
        g_ModMpBotHumanKills[attacker]++;
    }
    else if (attacker >= MOD_MP_BOT_BOT_TARGET_BASE)
    {
        s32 killerslot = attacker - MOD_MP_BOT_BOT_TARGET_BASE;
        if ((u32)killerslot < MOD_MP_BOT_MAX && killerslot != slot)
            g_ModMpBotRuntime[killerslot].kills++;
    }
}

static void modMpBotsMeleeAttack(s32 slot, PropRecord *target)
{
    struct ModMpBotRuntime *runtime = &g_ModMpBotRuntime[slot];
    coord3d direction;

    if (target == NULL || runtime->chr == NULL || runtime->chr->prop == NULL)
        return;

    direction.x = target->pos.x - runtime->chr->prop->pos.x;
    direction.y = target->pos.y - runtime->chr->prop->pos.y;
    direction.z = target->pos.z - runtime->chr->prop->pos.z;

    if (target->type == PROP_TYPE_VIEWER)
    {
        modMpBotsDamageViewer(slot, target, ITEM_FIST, &direction);
    }
    else if (target->type == PROP_TYPE_CHR && target->chr != NULL)
    {
        modMpBotsNotifyBotHit(target->chr, runtime->chr);
        handles_shot_actors(target->chr, HIT_CHEST, &direction, ITEM_FIST, FALSE);
    }
}

static void modMpBotsThink(s32 slot)
{
    struct ModMpBotRuntime *runtime = &g_ModMpBotRuntime[slot];
    struct ModMpBotConfig *config = &g_ModMpBotConfigs[slot];
    PropRecord *target;
    f32 dx;
    f32 dy;
    f32 dz;
    f32 dist2;
    f32 attackrange;
    SPEED speed;

    target = modMpBotsChooseTarget(slot);
    runtime->targetprop = target;

    if (target == NULL)
    {
        check_set_actor_standing_still(runtime->chr, TARGET_BOND, 0);
        return;
    }

    dx = target->pos.x - runtime->chr->prop->pos.x;
    dy = target->pos.y - runtime->chr->prop->pos.y;
    dz = target->pos.z - runtime->chr->prop->pos.z;
    dist2 = dx * dx + dy * dy + dz * dz;

    if (config->type == MODBOT_TYPE_MELEE)
    {
        if (dist2 <= MODBOT_MELEE_RANGE * MODBOT_MELEE_RANGE)
        {
            check_set_actor_standing_still(runtime->chr, TARGET_BOND, 0);
            if (runtime->meleecooldown <= 0)
            {
                modMpBotsMeleeAttack(slot, target);
                runtime->meleecooldown = g_ModMpBotMeleeTicks[config->difficulty];
            }
        }
        else
        {
            plot_course_for_actor(runtime->chr, &target->pos, target->stan, SPEED_SPRINT);
        }
        return;
    }

    attackrange = MODBOT_ATTACK_RANGE;
    if (config->type == MODBOT_TYPE_PSYCHO)
        attackrange = 300.0f;
    else if (config->type == MODBOT_TYPE_FEAR)
        attackrange = 550.0f;

    if (dist2 <= attackrange * attackrange)
    {
        if (!actor_fire_or_aim_at_target_update(runtime->chr, TARGET_BOND, 0))
            actor_aim_at_actor(runtime->chr, TARGET_BOND, 0);
    }
    else
    {
        speed = config->type == MODBOT_TYPE_PSYCHO ? SPEED_SPRINT : SPEED_RUN;
        plot_course_for_actor(runtime->chr, &target->pos, target->stan, speed);
    }
}

void modMpBotsTick(void)
{
    struct ModMpBotRuntime *runtime;
    struct ModMpBotConfig *config;
    s32 i;

    if (!modMpBotsRuntimeAllowed() || startpadcount <= 0)
        return;

    for (i = 0; i < g_ModMpBotCount; i++)
    {
        runtime = &g_ModMpBotRuntime[i];
        config = &g_ModMpBotConfigs[i];

        if (runtime->chr == NULL || runtime->chr->model == NULL || runtime->chr->prop == NULL)
        {
            runtime->chr = NULL;
            runtime->targetprop = NULL;
            if (runtime->respawntimer > 0)
            {
                runtime->respawntimer -= g_ClockTimer;
                continue;
            }
            modMpBotsSpawn(i);
            continue;
        }

        if (chrIsDead(runtime->chr))
        {
            if (!runtime->deathrecorded)
            {
                modMpBotsRecordDeath(i);
                runtime->deathrecorded = TRUE;
                runtime->respawntimer = MODBOT_RESPAWN_TICKS;
            }
            else
            {
                runtime->respawntimer -= g_ClockTimer;
                if (runtime->respawntimer <= 0)
                {
                    modMpBotsRemoveActor(i);
                    runtime->respawntimer = 1;
                }
            }
            continue;
        }

        runtime->deathrecorded = FALSE;

        if (runtime->meleecooldown > 0)
            runtime->meleecooldown -= g_ClockTimer;

        runtime->decisiontimer -= g_ClockTimer;
        if (runtime->decisiontimer <= 0)
        {
            modMpBotsThink(i);
            runtime->decisiontimer = g_ModMpBotDecisionTicks[config->difficulty];
            if (config->type == MODBOT_TYPE_PSYCHO && runtime->decisiontimer > 4)
                runtime->decisiontimer >>= 1;
        }
    }
}

